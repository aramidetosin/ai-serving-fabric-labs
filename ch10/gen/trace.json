{
  "kind": "nat",
  "lab": "sfab-ch10",
  "points": [
    {
      "eth": "eth1",
      "filter": "(tcp port 443) or (vlan and (tcp port 443))",
      "id": "1-isp-rtr-eth1",
      "node": "isp-rtr",
      "role": "router-uplink"
    },
    {
      "eth": "eth4",
      "filter": "(tcp port 443) or (vlan and (tcp port 443))",
      "id": "2-fw-ethernet1-4",
      "ifname": "ethernet1/4",
      "node": "fw",
      "role": "fw-ingress"
    },
    {
      "eth": "eth1",
      "filter": "(tcp port 443) or (vlan and (tcp port 443))",
      "id": "3-fw-ae1-leg1",
      "ifname": "ethernet1/1",
      "leg": 1,
      "node": "fw",
      "role": "leg"
    },
    {
      "eth": "eth2",
      "filter": "(tcp port 443) or (vlan and (tcp port 443))",
      "id": "3-fw-ae1-leg2",
      "ifname": "ethernet1/2",
      "leg": 2,
      "node": "fw",
      "role": "leg"
    }
  ],
  "schema": 1,
  "sessions": [
    {
      "ca_root": "/shared/ca/root.crt",
      "client": "inet-client",
      "client_addr": "203.0.113.2",
      "dst_addr": "198.51.100.10",
      "entry": "1-isp-rtr-eth1",
      "expect": {
        "from_zone": "isp",
        "nat_rule": "dnat-internet-gateway",
        "rule": "isp-to-internet-gateway",
        "status": 200,
        "to_zone": "ingress"
      },
      "fqdn": "llm.ai.tarnwick.example",
      "gateway": "gw-inet",
      "hold_s": 20,
      "hops": [
        "198.51.100.8/30 connected on eth1",
        "in on ethernet1/6 (zone isp): 198.51.100.10 is the firewall's own address on ethernet1/6, zone isp",
        "dnat-internet-gateway: destination 198.51.100.10 translated to 10.20.11.220, zone ingress",
        "isp-to-internet-gateway: allow, zone isp to ingress"
      ],
      "id": "internet",
      "legs": [
        "3-fw-ae1-leg1",
        "3-fw-ae1-leg2"
      ],
      "msg": "sfab-trace-nat",
      "path": "/echo?msg=sfab-trace-nat",
      "pin": false,
      "points": [
        "1-isp-rtr-eth1",
        "3-fw-ae1-leg1",
        "3-fw-ae1-leg2"
      ],
      "port": 443,
      "resolver": "inet-dns-res",
      "sport": 42936,
      "translated_addr": "10.20.11.220",
      "vip": "10.20.11.220",
      "vlan": 110
    },
    {
