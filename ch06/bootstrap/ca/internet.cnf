# sfab-ch06 lab CA, the internet intermediate: rendered from spec/profile-a.yaml by render/ca.py; edit the spec and run make render
# sfab-ca signs it with the root. Its name constraints are the only names and
# addresses any certificate under it can verify for.
# Role upstream: sfab-ca signs the upstream stand-ins' leaves with it on the lab host.
[sfab]
key = ec-p256
days = 1826
renew_days = 90
role = upstream

[req]
prompt = no
distinguished_name = dn

[dn]
O = Tarnwick
CN = Tarnwick Lab Internet CA

[ext]
basicConstraints = critical,CA:TRUE,pathlen:0
keyUsage = critical,keyCertSign,cRLSign,digitalSignature
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always
nameConstraints = critical,permitted;DNS:upstream.example,permitted;IP:192.0.2.0/255.255.255.0
