  "lab": "sfab-ch04",
  "list": [
    {
      "capture": {
        "eths": [
          "eth1",
          "eth2",
          "eth5"
        ],
        "filter": "icmp and host 10.20.1.12 and host 198.51.100.2"
      },
      "counter": "flow_policy_nat_land",
      "diag": {
        "destination": "198.51.100.2",
        "source": "10.20.1.12",
        "stages": [
          "receive",
          "drop"
        ]
      },
      "fw": "fw",
      "id": "land",
      "kind": "fw_nat_removed",
      "nat": {
        "element": "<entry name=\"no-nat-public\"><from><member>k8s-nodes</member><member>services</member></from><to><member>uplink</member></to><source><member>any</member></source><destination><member>198.51.100.2</member></destination><service>any</service><description>dec-nat-no-land</description></entry>",
        "order": [
          "no-nat-public",
          "internet-snat"
        ],
        "place": {
          "dst": "internet-snat",
          "where": "before"
        },
        "rule": "no-nat-public",
        "rules_xpath": "/config/devices/entry[@name='localhost.localdomain']/vsys/entry[@name='vsys1']/rulebase/nat/rules",
        "table": "nat",
        "xpath": "/config/devices/entry[@name='localhost.localdomain']/vsys/entry[@name='vsys1']/rulebase/nat/rules/entry[@name='no-nat-public']"
      },
      "probe": "public",
      "title": "no-nat-public removed, a node's requests to the public address discarded as a LAND attack"
    },
    {
      "capture": {
        "eths": [
          "eth1",
          "eth2",
          "eth5"
        ],
        "filter": "udp port 123 or udp port 53"
      },
      "domain": "ai.tarnwick.example",
      "element": "<entry name=\"ntp\"><source><interface>ethernet1/5</interface><address>198.51.100.2/29</address></source></entry>",
      "expect_rule": "deny-all-log",
      "from": {
        "address": "10.20.13.1",
        "interface": "ae1.130",
        "zone": "services"
      },
      "fw": "fw",
      "id": "ntp-uplink",
      "kind": "fw_service_route",
      "port": 123,
      "restore_element": "<entry name=\"ntp\"><source><interface>ae1.130</interface><address>10.20.13.1/24</address></source></entry>",
      "restore_rule": "inside-to-ntp",
      "server": "10.20.13.21",
      "server_zone": "services",
      "service": "ntp",
      "title": "the firewall's own NTP and DNS sent from the uplink by their service routes, dropped by deny-all-log",
      "to": {
        "address": "198.51.100.2",
        "interface": "ethernet1/5",
        "zone": "uplink"
      },
      "with": [
        {
          "element": "<entry name=\"dns\"><source><interface>ethernet1/5</interface><address>198.51.100.2/29</address></source></entry>",
          "port": 53,
          "restore_element": "<entry name=\"dns\"><source><interface>ae1.130</interface><address>10.20.13.1/24</address></source></entry>",
          "restore_rule": "inside-to-resolvers",
          "server": "10.20.13.21",
          "service": "dns",
          "xpath": "/config/devices/entry[@name='localhost.localdomain']/deviceconfig/system/route/service/entry[@name='dns']"
        }
      ],
      "xpath": "/config/devices/entry[@name='localhost.localdomain']/deviceconfig/system/route/service/entry[@name='ntp']"
    }
  ],
