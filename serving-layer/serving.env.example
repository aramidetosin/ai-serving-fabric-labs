# serving.env for a cluster outside the labs: copy this file, change what your cluster differs in,
# and run `make serve SERVING_ENV=<your file>`. The labs write their own from the spec
# (bootstrap/k8s/serving.env in a chapter's lab). KEY=value lines with shell quoting; a table is
# numbered rows (01, 02, ...), its row count and its column names beside it.
#
# What the cluster needs: Multus, the CNI macvlan and static plugins on every node that runs a
# pod, a NIC on each node for every rail a row names (master), a Gateway API implementation with
# the Gateway named below, and the two images pushed where the nodes can pull them.

SERVING_NAMESPACE=serving
# Labels the namespace carries, space-separated key=value pairs: a Gateway whose listener admits
# routes only from labelled namespaces needs its label here (empty when it admits All).
SERVING_NAMESPACE_LABELS=
# How to run kubectl: a plain kubectl here, or, in the labs, 'common/bin/sfab-kubectl <lab directory>'.
SERVING_KUBECTL=kubectl
# DaemonSets to wait for before the pods: <namespace>/<name>, space-separated (Multus here).
SERVING_WAIT_DAEMONSETS=kube-system/kube-multus-ds
# Build both with `make -C images serving keys`, then push them to a registry your nodes reach.
SERVING_IMAGE=registry.example:5000/sfab/serving:b11382-2
SERVING_KEYS_IMAGE=registry.example:5000/sfab/keys:1
# The key the servers take, generated in the cluster as <prefix>-<32 hex> and never printed.
SERVING_KEY_SECRET=llm-api-key
SERVING_KEY_FIELD=key
SERVING_KEY_PREFIX=sk-ex-serving
# Label keys are <prefix>/model, /copy, /role, /pod and /rail; the decision label is optional.
SERVING_LABEL_PREFIX=serving.example
SERVING_DECISION_LABEL=
SERVING_HTTP_PORT=8080
SERVING_RPC_PORT=50052
# A port where nothing listens on a worker: the server's readiness probe connects to it over the
# rail and wants the worker's kernel to refuse it. A filter on the rail must reject that port with
# a reset, never drop it, or every copy goes unready together.
SERVING_RAIL_PROBE_PORT=50053
# Where the weights are on every node that runs a server (read-only is enough): the recipe makes a
# local PersistentVolume of this path on each such node and mounts it in the servers at /models.
SERVING_MODELS_PATH=/srv/models
SERVING_SERVER_ARGS='-ngl 99 -c 4096 -np 8 -n 256 -t 2 --reasoning-budget 0 --cache-ram 0 --ctx-checkpoints 0'
SERVING_WORKER_ARGS='-t 4'
SERVING_READINESS_PERIOD_S=2
SERVING_READINESS_FAILURES=2
SERVING_READINESS_TIMEOUT_S=2

# One macvlan attachment per rail: name, the node NIC it rides (the same name on every node),
# the rail's prefix, the MTU.
SERVING_NAD_COLUMNS='name master prefix mtu'
SERVING_NADS=2
SERVING_NAD_01='rail3 rail3 10.21.3.0/24 9000'
SERVING_NAD_02='rail6 rail6 10.21.6.0/24 9000'

# The models: name, the alias llama-server answers to, an id (free text, no spaces), the weights'
# file under SERVING_MODELS_PATH and its size in bytes (a worker's memory request is its share).
SERVING_MODEL_COLUMNS='name alias route_id file bytes'
SERVING_MODELS=1
SERVING_MODEL_01='chat chat chat LFM2.5-24B-A2B-Q4_K_M.gguf 14526258464'

# The placement table: one row per pod, each the one pod of its own StatefulSet (<row>-0). Every
# pod of a copy sits on one rail; a copy has one server and at least one worker; each address is
# fixed and inside its rail's prefix, clear of the nodes' own addresses there; node is the
# Kubernetes node name. Copy a sits inside node1 (its RPC stays in the node's macvlan bridge);
# copy b spans both nodes, so its RPC to worker1 crosses the rail switch.
SERVING_POD_COLUMNS='pod model copy role index node rail nad address decision'
SERVING_PODS=5
SERVING_POD_01='chat-a-server-0 chat a server 0 node1 3 rail3 10.21.3.100/24 -'
SERVING_POD_02='chat-a-worker0-0 chat a worker 0 node1 3 rail3 10.21.3.101/24 -'
SERVING_POD_03='chat-b-server-0 chat b server 0 node2 6 rail6 10.21.6.100/24 -'
SERVING_POD_04='chat-b-worker0-0 chat b worker 0 node2 6 rail6 10.21.6.101/24 -'
SERVING_POD_05='chat-b-worker1-0 chat b worker 1 node1 6 rail6 10.21.6.102/24 -'

# The recipe's own HTTPRoute: one Gateway, one hostname, a rule per model and per copy.
SERVING_ROUTE_NAME=serving
SERVING_ROUTE_GATEWAY=internal
SERVING_ROUTE_GATEWAY_NAMESPACE=gateways
SERVING_ROUTE_SECTION=https
SERVING_ROUTE_HOSTNAME=serve.example.com
SERVING_ROUTE_REQUEST_TIMEOUT=900s
SERVING_ROUTE_BACKEND_TIMEOUT=900s

# make load: where load.py runs (empty: here), its base URL, and an optional host:port:address pin.
SERVING_LOAD_EXEC=
SERVING_LOAD_URL=https://serve.example.com/chat/v1
SERVING_LOAD_RESOLVE=
