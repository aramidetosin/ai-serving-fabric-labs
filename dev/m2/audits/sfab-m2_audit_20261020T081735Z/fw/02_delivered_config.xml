<config version="12.1.0" urldb="paloaltonetworks" detail-version="12.1.2">
  <devices>
    <entry name="localhost.localdomain">
      <deviceconfig>
        <system>
          <hostname>fw</hostname>
          <timezone>UTC</timezone>
          <dns-setting>
            <servers>
              <primary>10.20.3.10</primary>
            </servers>
          </dns-setting>
          <ntp-servers>
            <primary-ntp-server>
              <ntp-server-address>10.20.3.10</ntp-server-address>
            </primary-ntp-server>
          </ntp-servers>
          <route>
            <service>
              <entry name="dns">
                <source>
                  <interface>ethernet1/3</interface>
                  <address>10.20.9.254/24</address>
                </source>
              </entry>
              <entry name="ntp">
                <source>
                  <interface>ethernet1/3</interface>
                  <address>10.20.9.254/24</address>
                </source>
              </entry>
            </service>
          </route>
        </system>
        <setting>
          <management>
            <idle-timeout>0</idle-timeout>
          </management>
          <auto-mac-detect>yes</auto-mac-detect>
          <jumbo-frame>
            <mtu>9216</mtu>
          </jumbo-frame>
        </setting>
      </deviceconfig>
      <network>
        <profiles>
          <interface-management-profile>
            <entry name="ping-only">
              <ping>yes</ping>
            </entry>
          </interface-management-profile>
        </profiles>
        <interface>
          <ethernet>
            <entry name="ethernet1/1">
              <aggregate-group>ae1</aggregate-group>
            </entry>
            <entry name="ethernet1/2">
              <aggregate-group>ae1</aggregate-group>
            </entry>
            <entry name="ethernet1/3">
              <layer3>
                <ip>
                  <entry name="10.20.9.254/24"/>
                </ip>
                <interface-management-profile>ping-only</interface-management-profile>
              </layer3>
            </entry>
            <entry name="ethernet1/4">
              <layer3>
                <ip>
                  <entry name="10.24.10.1/24"/>
                </ip>
                <interface-management-profile>ping-only</interface-management-profile>
              </layer3>
            </entry>
            <entry name="ethernet1/5">
              <layer3>
                <ip>
                  <entry name="198.51.100.2/29"/>
                </ip>
                <interface-management-profile>ping-only</interface-management-profile>
              </layer3>
            </entry>
          </ethernet>
          <aggregate-ethernet>
            <entry name="ae1">
              <layer3>
                <mtu>9216</mtu>
                <lacp>
                  <enable>yes</enable>
                  <mode>active</mode>
                  <transmission-rate>fast</transmission-rate>
                </lacp>
                <units>
                  <entry name="ae1.100">
                    <tag>100</tag>
                    <ip>
                      <entry name="10.20.1.1/24"/>
                    </ip>
                    <mtu>9216</mtu>
                    <interface-management-profile>ping-only</interface-management-profile>
                  </entry>
                  <entry name="ae1.200">
                    <tag>200</tag>
                    <ip>
                      <entry name="10.20.2.1/24"/>
                    </ip>
                    <mtu>9216</mtu>
                    <interface-management-profile>ping-only</interface-management-profile>
                  </entry>
                  <entry name="ae1.300">
                    <tag>300</tag>
                    <ip>
                      <entry name="10.20.3.1/24"/>
                    </ip>
                    <mtu>9216</mtu>
                    <interface-management-profile>ping-only</interface-management-profile>
                  </entry>
                </units>
              </layer3>
            </entry>
          </aggregate-ethernet>
        </interface>
        <virtual-router>
          <entry name="core">
            <interface>
              <member>ae1.100</member>
              <member>ae1.200</member>
              <member>ae1.300</member>
              <member>ethernet1/3</member>
              <member>ethernet1/4</member>
              <member>ethernet1/5</member>
            </interface>
            <routing-table>
              <ip>
                <static-route>
                  <entry name="default-uplink">
                    <destination>0.0.0.0/0</destination>
                    <interface>ethernet1/5</interface>
                    <nexthop>
                      <ip-address>198.51.100.1</ip-address>
                    </nexthop>
                  </entry>
                </static-route>
              </ip>
            </routing-table>
          </entry>
        </virtual-router>
      </network>
      <vsys>
        <entry name="vsys1">
          <import>
            <network>
              <interface>
                <member>ae1.100</member>
                <member>ae1.200</member>
                <member>ae1.300</member>
                <member>ethernet1/3</member>
                <member>ethernet1/4</member>
                <member>ethernet1/5</member>
              </interface>
            </network>
          </import>
          <zone>
            <entry name="data">
              <network>
                <layer3>
                  <member>ae1.100</member>
                </layer3>
              </network>
            </entry>
            <entry name="stor-mgmt">
              <network>
                <layer3>
                  <member>ae1.200</member>
                </layer3>
              </network>
            </entry>
            <entry name="bastion">
              <network>
                <layer3>
                  <member>ae1.300</member>
                </layer3>
              </network>
            </entry>
            <entry name="oob">
              <network>
                <layer3>
                  <member>ethernet1/3</member>
                </layer3>
              </network>
            </entry>
            <entry name="enterprise">
              <network>
                <layer3>
                  <member>ethernet1/4</member>
                </layer3>
              </network>
            </entry>
            <entry name="uplink">
              <network>
                <layer3>
                  <member>ethernet1/5</member>
                </layer3>
              </network>
            </entry>
          </zone>
          <service>
            <entry name="tcp-22">
              <protocol>
                <tcp>
                  <port>22</port>
                </tcp>
              </protocol>
            </entry>
            <entry name="tcp-443">
              <protocol>
                <tcp>
                  <port>443</port>
                </tcp>
              </protocol>
            </entry>
            <entry name="tcp-6443">
              <protocol>
                <tcp>
                  <port>6443</port>
                </tcp>
              </protocol>
            </entry>
            <entry name="tcp-53">
              <protocol>
                <tcp>
                  <port>53</port>
                </tcp>
              </protocol>
            </entry>
            <entry name="udp-53">
              <protocol>
                <udp>
                  <port>53</port>
                </udp>
              </protocol>
            </entry>
            <entry name="udp-123">
              <protocol>
                <udp>
                  <port>123</port>
                </udp>
              </protocol>
            </entry>
          </service>
          <rulebase>
            <security>
              <rules>
                <entry name="enterprise-to-users-gateway">
                  <from>
                    <member>enterprise</member>
                  </from>
                  <to>
                    <member>data</member>
                  </to>
                  <source>
                    <member>10.24.10.0/24</member>
                  </source>
                  <destination>
                    <member>10.20.1.210</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>tcp-443</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                  <description>dec-policy-enterprise-users</description>
                </entry>
                <entry name="enterprise-to-bastion-dns">
                  <from>
                    <member>enterprise</member>
                  </from>
                  <to>
                    <member>bastion</member>
                  </to>
                  <source>
                    <member>10.24.10.0/24</member>
                  </source>
                  <destination>
                    <member>10.20.3.10</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>udp-53</member>
                    <member>tcp-53</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="bastion-to-data">
                  <from>
                    <member>bastion</member>
                  </from>
                  <to>
                    <member>data</member>
                  </to>
                  <source>
                    <member>10.20.3.10</member>
                  </source>
                  <destination>
                    <member>10.20.1.0/24</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>tcp-22</member>
                    <member>tcp-443</member>
                    <member>tcp-6443</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="bastion-to-stor-mgmt">
                  <from>
                    <member>bastion</member>
                  </from>
                  <to>
                    <member>stor-mgmt</member>
                  </to>
                  <source>
                    <member>10.20.3.10</member>
                  </source>
                  <destination>
                    <member>10.20.2.0/24</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>tcp-443</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="bastion-to-oob">
                  <from>
                    <member>bastion</member>
                  </from>
                  <to>
                    <member>oob</member>
                  </to>
                  <source>
                    <member>10.20.3.10</member>
                  </source>
                  <destination>
                    <member>10.20.9.0/24</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="oob-to-bastion-dns-ntp">
                  <from>
                    <member>oob</member>
                  </from>
                  <to>
                    <member>bastion</member>
                  </to>
                  <source>
                    <member>10.20.9.0/24</member>
                  </source>
                  <destination>
                    <member>10.20.3.10</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>udp-53</member>
                    <member>tcp-53</member>
                    <member>udp-123</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="inside-to-bastion-dns-ntp">
                  <from>
                    <member>data</member>
                    <member>stor-mgmt</member>
                  </from>
                  <to>
                    <member>bastion</member>
                  </to>
                  <source>
                    <member>10.20.1.0/24</member>
                    <member>10.20.2.0/24</member>
                  </source>
                  <destination>
                    <member>10.20.3.10</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>udp-53</member>
                    <member>tcp-53</member>
                    <member>udp-123</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="inside-to-internet">
                  <from>
                    <member>data</member>
                    <member>stor-mgmt</member>
                    <member>bastion</member>
                  </from>
                  <to>
                    <member>uplink</member>
                  </to>
                  <source>
                    <member>10.20.1.0/24</member>
                    <member>10.20.2.0/24</member>
                    <member>10.20.3.0/24</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="uplink-to-internal-gateway">
                  <from>
                    <member>uplink</member>
                  </from>
                  <to>
                    <member>data</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.51.100.2</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>tcp-443</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                  <description>dec-nat-operator</description>
                </entry>
                <entry name="data-intrazone">
                  <from>
                    <member>data</member>
                  </from>
                  <to>
                    <member>data</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="stor-mgmt-intrazone">
                  <from>
                    <member>stor-mgmt</member>
                  </from>
                  <to>
                    <member>stor-mgmt</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="bastion-intrazone">
                  <from>
                    <member>bastion</member>
                  </from>
                  <to>
                    <member>bastion</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="oob-intrazone">
                  <from>
                    <member>oob</member>
                  </from>
                  <to>
                    <member>oob</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="enterprise-intrazone">
                  <from>
                    <member>enterprise</member>
                  </from>
                  <to>
                    <member>enterprise</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="deny-all-log">
                  <from>
                    <member>any</member>
                  </from>
                  <to>
                    <member>any</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>deny</action>
                  <log-end>yes</log-end>
                  <description>dec-policy-deny-all-log</description>
                </entry>
              </rules>
            </security>
            <nat>
              <rules>
                <entry name="dnat-operator-gateway">
                  <from>
                    <member>uplink</member>
                  </from>
                  <to>
                    <member>uplink</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.51.100.2</member>
                  </destination>
                  <service>tcp-443</service>
                  <destination-translation>
                    <translated-address>10.20.1.200</translated-address>
                  </destination-translation>
                  <description>dec-nat-operator</description>
                </entry>
                <entry name="no-nat-public">
                  <from>
                    <member>data</member>
                    <member>stor-mgmt</member>
                    <member>bastion</member>
                  </from>
                  <to>
                    <member>uplink</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.51.100.2</member>
                  </destination>
                  <service>any</service>
                  <description>dec-nat-no-land</description>
                </entry>
                <entry name="internet-snat">
                  <from>
                    <member>data</member>
                    <member>stor-mgmt</member>
                    <member>bastion</member>
                  </from>
                  <to>
                    <member>uplink</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                  <source-translation>
                    <dynamic-ip-and-port>
                      <interface-address>
                        <interface>ethernet1/5</interface>
                      </interface-address>
                    </dynamic-ip-and-port>
                  </source-translation>
                </entry>
              </rules>
            </nat>
          </rulebase>
        </entry>
      </vsys>
